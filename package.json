  "scripts": {
    "build": "yarn node bin/bake.js",
    "build:remote": "jolt aws codebuild start --batch '{tf:codebuild_project_name}'",
    "lint": "biome check",
    "prepare": "jolt prepare",
    "push": "yarn run build --push"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@joltdesign/scripts": "^2.1.1"
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f"
}
