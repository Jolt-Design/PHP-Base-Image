{
  "name": "@joltdesign/docker-php-base",
  "version": "1.0.0",
  "repository": "git@github.com:Jolt-Design/PHP-Base-Image.git",
  "author": "Jolt Design <studio@joltdesign.co.uk>",
  "license": "None",
  "private": true,
  "jira-prepare-commit-msg": {
    "messagePattern": "$J $M",
    "ignoredBranchesPattern": "^(dependabot/|renovate/)"
